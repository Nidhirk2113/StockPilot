generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Product {
  id             String           @id @default(cuid())
  name           String
  sku            String           @unique
  category       String
  price          Decimal          @db.Decimal(10, 2)
  stock          Int              @default(0)
  reorderAt      Int              @default(5)
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt
  salesRecords   SalesRecord[]
  stockMovements StockMovement[]

  @@index([category])
  @@index([stock, reorderAt])
}

model SalesImport {
  id             String        @id @default(cuid())
  idempotencyKey String        @unique
  fileName       String
  recordCount    Int
  createdAt      DateTime      @default(now())
  records        SalesRecord[]
}

model SalesRecord {
  id         String       @id @default(cuid())
  saleDate   DateTime
  productId  String?
  product    Product?     @relation(fields: [productId], references: [id], onDelete: SetNull)
  productName String
  category   String       @default("Uncategorized")
  unitsSold  Int
  revenue    Decimal?     @db.Decimal(14, 2)
  source     String       @default("CSV upload")
  importId   String?
  import     SalesImport? @relation(fields: [importId], references: [id], onDelete: SetNull)
  createdAt  DateTime     @default(now())

  @@index([saleDate])
  @@index([productId, saleDate])
  @@index([productName])
  @@index([category, saleDate])
}

model StockMovement {
  id          String   @id @default(cuid())
  productId   String
  product     Product  @relation(fields: [productId], references: [id], onDelete: Restrict)
  type        String
  quantity    Int
  stockBefore Int
  stockAfter  Int
  reference   String?
  note        String?
  createdAt   DateTime @default(now())

  @@index([productId, createdAt])
  @@index([type, createdAt])
}


model HistoricalGameDatasetImport {
  id             String             @id @default(cuid())
  idempotencyKey String             @unique
  fileName       String
  recordCount    Int
  createdAt      DateTime           @default(now())
  records        HistoricalGameSale[]
}

model HistoricalGameSale {
  id             String                    @id @default(cuid())
  datasetImportId String
  datasetImport  HistoricalGameDatasetImport @relation(fields: [datasetImportId], references: [id], onDelete: Cascade)
  rank           Int
  name           String
  platform       String
  year           Int?
  genre          String
  publisher      String?
  naSales        Decimal                   @db.Decimal(10, 2)
  euSales        Decimal                   @db.Decimal(10, 2)
  jpSales        Decimal                   @db.Decimal(10, 2)
  otherSales     Decimal                   @db.Decimal(10, 2)
  globalSales    Decimal                   @db.Decimal(10, 2)

  @@unique([datasetImportId, rank])
  @@index([year])
  @@index([genre])
  @@index([platform])
  @@index([publisher])
  @@index([year, genre])
}
